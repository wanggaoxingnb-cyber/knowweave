{"concept": "Attention", "title": "Attention：读句子时的重点关照", "html": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  body {\n    margin: 0;\n    background: #0f1420;\n    font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n    color: #e0e6f0;\n  }\n  .card {\n    background: #1a2130;\n    border-radius: 16px;\n    padding: 24px 28px;\n    max-width: 680px;\n    width: 90%;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.5);\n  }\n  h2 {\n    margin: 0 0 12px;\n    font-size: 22px;\n    color: #8ab4ff;\n    text-align: center;\n  }\n  .sentence {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    gap: 8px;\n    margin: 20px 0;\n    font-size: 20px;\n    line-height: 1.6;\n  }\n  .word {\n    background: #2a3444;\n    padding: 6px 12px;\n    border-radius: 8px;\n    cursor: pointer;\n    transition: all 0.3s;\n    border: 2px solid transparent;\n    user-select: none;\n  }\n  .word:hover {\n    border-color: #8ab4ff;\n  }\n  .word.active {\n    background: #3d5a80;\n    border-color: #ffb74d;\n    box-shadow: 0 0 12px rgba(255,183,77,0.4);\n  }\n  .word.attention {\n    background: #4a3f2a;\n    border-color: #ffb74d;\n  }\n  .controls {\n    display: flex;\n    justify-content: center;\n    gap: 12px;\n    margin: 16px 0;\n  }\n  button {\n    background: #2a3444;\n    color: #e0e6f0;\n    border: none;\n    padding: 10px 20px;\n    border-radius: 8px;\n    font-size: 16px;\n    cursor: pointer;\n    transition: background 0.2s;\n  }\n  button:hover {\n    background: #3d5a80;\n  }\n  .explain {\n    background: #1f2a3a;\n    border-radius: 10px;\n    padding: 14px;\n    margin-top: 16px;\n    font-size: 16px;\n    line-height: 1.6;\n    min-height: 60px;\n    border-left: 4px solid #ffb74d;\n  }\n  .hint {\n    font-size: 14px;\n    color: #8899aa;\n    text-align: center;\n    margin-top: 8px;\n  }\n</style>\n</head>\n<body>\n<div class=\"card\">\n  <h2>🎯 Attention：读句子时的重点关照</h2>\n  <div class=\"sentence\" id=\"sentence\">\n    <span class=\"word\" data-idx=\"0\">苹果</span>\n    <span class=\"word\" data-idx=\"1\">公司</span>\n    <span class=\"word\" data-idx=\"2\">发布了</span>\n    <span class=\"word\" data-idx=\"3\">新手机</span>\n    <span class=\"word\" data-idx=\"4\">，</span>\n    <span class=\"word\" data-idx=\"5\">它</span>\n    <span class=\"word\" data-idx=\"6\">很贵</span>\n  </div>\n  <div class=\"controls\">\n    <button onclick=\"showAttention()\">▶ 看 Attention 如何工作</button>\n    <button onclick=\"reset()\">重置</button>\n  </div>\n  <div class=\"explain\" id=\"explain\">\n    点击按钮，看看模型如何理解“它”指代什么。\n  </div>\n  <div class=\"hint\">💡 就像开会时领导说“那个项目”，你会自动对上号</div>\n</div>\n\n<script>\n  const words = document.querySelectorAll('.word');\n  const explain = document.getElementById('explain');\n  let active = false;\n\n  function showAttention() {\n    if (active) return;\n    active = true;\n    // 高亮“它”和“新手机”\n    words[5].classList.add('active');\n    words[3].classList.add('attention');\n    explain.innerHTML = '模型看到“它”时，会计算每个词的相关性。<br>🔸 <b>“新手机”</b> 获得最高关注（权重高），所以“它”指手机。<br>🔹 “苹果”也有一定关注，但不如“新手机”。';\n    // 添加连线效果（简单模拟）\n    words[5].style.boxShadow = '0 0 16px rgba(255,183,77,0.8)';\n    words[3].style.boxShadow = '0 0 16px rgba(138,180,255,0.6)';\n  }\n\n  function reset() {\n    active = false;\n    words.forEach(w => {\n      w.classList.remove('active', 'attention');\n      w.style.boxShadow = '';\n    });\n    explain.innerHTML = '点击按钮，看看模型如何理解“它”指代什么。';\n  }\n</script>\n</body>\n</html>"}